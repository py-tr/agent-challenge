{
  "name": "nosana-eliza-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "build:frontend": "cd frontend && pnpm build",
    "predev": "cd frontend && pnpm build",
    "dev": "elizaos dev",
    "dev:hot": "concurrently -n frontend,agent -c blue,green \"cd frontend && pnpm dev\" \"elizaos dev\"",
    "start": "elizaos start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@elizaos/core": "^1.0.0",
    "@elizaos/plugin-anthropic": "^1.5.12",
    "@elizaos/plugin-bootstrap": "^1.0.0",
    "@elizaos/plugin-openai": "^1.0.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@elizaos/cli": "^1.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
