# =============================================================
# Pulse — Autonomous Chief of Staff
# Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# -------------------------------------------------------------
# LLM Configuration — Qwen3.5-27B via Nosana Inference Endpoint
# -------------------------------------------------------------
# Nosana provides a hosted Qwen3.5-27B endpoint for the challenge.
#
#OPENAI_API_KEY=nosana
#OPENAI_API_URL=https://5i8frj7ann99bbw9gzpprvzj2esugg39hxbb4unypskq.node.k8s.prd.nos.ci/v1
#OPENAI_BASE_URL=https://5i8frj7ann99bbw9gzpprvzj2esugg39hxbb4unypskq.node.k8s.prd.nos.ci/v1
#
## Model names as served by the Nosana endpoint
#OPENAI_SMALL_MODEL=Qwen3.5-9B-FP8
#OPENAI_LARGE_MODEL=Qwen3.5-9B-FP8

# -------------------------------------------------------------
# Option B: Local development with Ollama (optional)
# -------------------------------------------------------------
# Install Ollama: https://ollama.com/download
# Then run: ollama pull qwen3.5:27b && ollama serve
#
#OPENAI_API_KEY=ollama
#OPENAI_API_URL=http://127.0.0.1:11434/v1
#OPENAI_SMALL_MODEL=qwen3.5:27b
#OPENAI_LARGE_MODEL=qwen3.5:27b

# -------------------------------------------------------------
# Agent Server Configuration
# -------------------------------------------------------------
SERVER_PORT=3000
NODE_ENV=development

# -------------------------------------------------------------
# Pulse Job Configuration
# -------------------------------------------------------------
# Controls which processing mode runs when started via Nosana.
# Values: "morning" | "evening"
PULSE_JOB_TYPE=morning

# Set to "none" unless you have a dedicated embedding endpoint.
EMBEDDING_PROVIDER=none

# -------------------------------------------------------------
# Google OAuth — Gmail + Calendar via MCP
# -------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Required scopes: gmail.readonly, gmail.send, calendar.readonly, calendar.events

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -------------------------------------------------------------
# User Display Name (optional)
# -------------------------------------------------------------
# Shown as the signature in outgoing email drafts ("Best, <NAME>").
# Falls back to USER_DISPLAY_NAME, then "Pulse User" if neither is set.
USER_NAME=

# -------------------------------------------------------------
# Optional: Demo / Recovery
# -------------------------------------------------------------
# Set to "true" to wipe and re-seed the PGLite DB on startup (demo recovery).
# RESET_DB=false

# Set to "true" to use cached PGLite data instead of live Gmail/Calendar calls.
# PULSE_OFFLINE_MODE=false
