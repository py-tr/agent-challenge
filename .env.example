# =============================================================
# Pulse — Autonomous Chief of Staff
# Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# -------------------------------------------------------------
# LLM Configuration — Ollama (Primary)
# -------------------------------------------------------------
# Pulse runs a local Ollama instance as the primary inference backend.
# Install Ollama: https://ollama.com/download
# Then run: ollama pull qwen2.5:14b

# Model to serve locally (default: qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:14b

# Ollama API base URL — change if running Ollama on a different host/port
OLLAMA_BASE_URL=http://localhost:11434/v1

# Set to "true" to skip Ollama and route all inference to OPENAI_API_URL below.
# Useful when deploying to a market where the model is already a required resource.
# SKIP_OLLAMA=false

# -------------------------------------------------------------
# LLM Fallback — Nosana / OpenAI-compatible Endpoint
# -------------------------------------------------------------
# Used when Ollama is unavailable or SKIP_OLLAMA=true.
#
#OPENAI_API_KEY=nosana
#OPENAI_API_URL=https://<node-id>.node.k8s.prd.nos.ci/v1
#OPENAI_SMALL_MODEL=qwen2.5:14b
#OPENAI_LARGE_MODEL=qwen2.5:14b

# -------------------------------------------------------------
# Agent Server Configuration
# -------------------------------------------------------------
SERVER_PORT=3000
NODE_ENV=development

# Your local timezone (IANA format) — used for date calculations in LLM prompts,
# calendar filtering, and scheduling. Set this to your timezone so dates are
# correct regardless of where the server (or Nosana node) is running.
# Find your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Prague

# -------------------------------------------------------------
# Pulse Job Configuration
# -------------------------------------------------------------
# Controls which processing mode runs when started via Nosana.
# Values: "morning" | "evening"
PULSE_JOB_TYPE=morning

# Set to "none" unless you have a dedicated embedding endpoint.
EMBEDDING_PROVIDER=none

# -------------------------------------------------------------
# Google OAuth — Gmail + Calendar via MCP
# -------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Required scopes: gmail.readonly, gmail.send, calendar.readonly, calendar.events

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -------------------------------------------------------------
# User Display Name (optional)
# -------------------------------------------------------------
# Shown as the signature in outgoing email drafts ("Best, <NAME>").
# Falls back to USER_DISPLAY_NAME, then "Pulse User" if neither is set.
USER_NAME=

# -------------------------------------------------------------
# Optional: Demo / Recovery
# -------------------------------------------------------------
# Set to "true" to auto-seed demo data on first boot (no wipe — safe to leave on).
# Useful for fresh Nosana deployments so the dashboard isn't empty.
# PULSE_SEED_ON_START=false

# Set to "true" to wipe and re-seed the PGLite DB on startup (demo recovery).
# RESET_DB=false

# Public base URL for OAuth redirect callbacks (e.g. https://your-node.nos.ci).
# Required if self-hosting the OAuth relay instead of using the GitHub Pages relay.
# PULSE_PUBLIC_URL=
