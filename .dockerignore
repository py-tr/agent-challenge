.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
LICENSE

# Docker
Dockerfile
.dockerignore

# Temporary files
*.tmp
*.temp
.cache/

# Test files
coverage/
.nyc_output/
*.test.js
*.spec.js

# Scripts not needed in image
scripts/
