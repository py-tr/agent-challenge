{
  "version": "0.1",
  "ops": [
    {
      "id": "agent",
      "type": "container/run",
      "args": {
        "image": "pytrdev/pulse-agent:latest",
        "gpu": true,
        "expose": 3000,
        "env": {
          "SERVER_PORT": "3000",
          "NODE_ENV": "production",
          "TZ": "Europe/Prague",
          "PULSE_JOB_TYPE": "morning",
          "EMBEDDING_PROVIDER": "none",
          "PULSE_SEED_ON_START": "true",

          "OLLAMA_MODEL": "qwen2.5:14b",
          "OLLAMA_BASE_URL": "http://localhost:11434/v1",
          "SKIP_OLLAMA": "false",

          "OPENAI_API_KEY": "nosana",
          "OPENAI_API_URL": "",
          "OPENAI_SMALL_MODEL": "qwen2.5:14b",
          "OPENAI_LARGE_MODEL": "qwen2.5:14b",

          "GOOGLE_CLIENT_ID": "",
          "GOOGLE_CLIENT_SECRET": "",
          "GOOGLE_REFRESH_TOKEN": "",

          "USER_NAME": ""
        }
      }
    }
  ]
}
